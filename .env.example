# Set to false for deterministic demo analysis. This does not affect the realtime voice module.
LLM_ENABLED=true
# Set to true to return the fixed demo report instead of generating from the brief and Maya call.
MOCK_REPORT=false

LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=
DASHSCOPE_BASE_URL=
DASHSCOPE_REALTIME_BASE_URL=
DASHSCOPE_REALTIME_MODEL=qwen3.5-omni-flash-realtime

# Synthesia Interactive Avatar configuration. Keep the API key server-side only.
SYNTHESIA_API_KEY=
SYNTHESIA_AVATAR_ID=
SYNTHESIA_SESSIONS_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=common-ground-maya
# Optional Cartesia female voice override for Maya.
MAYA_TTS_VOICE_ID=

API_PORT=3002
NEXT_PUBLIC_API_URL=http://127.0.0.1:3002
